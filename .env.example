# Copy to .env and use with: uv run --env-file .env jobhunt run
# Without this, notifications are printed to the console instead.

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123/abc

# Optional
# JOBHUNT_DB=data/jobs.db
# JOBHUNT_TZ=America/Toronto
